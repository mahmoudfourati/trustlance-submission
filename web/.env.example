# Copy to web/.env.local (git-ignored) for local development. On Vercel, set these in the project settings.
# Never commit real values.

# --- Upload proxy (server only) ---------------------------------------------------------------
# Read by the /api/upload-url function and the Vite dev middleware. Never prefix these with VITE_:
# VITE_ variables are bundled into the public JavaScript.

# Pinata JWT with the org:files:write scope (Pinata dashboard > API Keys).
PINATA_JWT=

# RPC used to check that the signer is the freelancer of an Active project with that milestone Pending.
# One variable per chain id; the local Hardhat node is served by default.
UPLOAD_PROXY_RPC_URL_31337=http://127.0.0.1:8545
UPLOAD_PROXY_RPC_URL_11155111=

# --- Web app (public, bundled into the browser) ---------------------------------------------
VITE_DEFAULT_CHAIN_ID=31337
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# Must keep the full event-log history back to the deployment block (publicnode prunes logs older than ~10,000 blocks).
VITE_SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
# Dedicated Pinata gateway host (no https://, no path), tried before the public IPFS gateways. Optional.
VITE_PINATA_GATEWAY=
